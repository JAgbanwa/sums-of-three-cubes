\subsection{when $k = 3$}


The case of $k = 3$ is a solved case with known results to be 

$(x,y,z)=(1,1,1) (4,4,-5) ( 569936821221962380720, -569936821113563493509, -472715493453327032)$

The corresponding elliptic curve equation for $k = 3$ given the equation \eqref{2.117} is:

\begin{align*}
    E_{3,r}: P^2 = u^3 + A u + B
\end{align*}


where

\begin{align*}
    A = -6n - 3
\end{align*}

\begin{align*}
   B &= -\left(\frac{(6n+3)^6}{108} - \frac{3 \cdot (6n+3)^3}{18} - \frac{9}{36}\right)\\
     &= -(432n^6 + 1296n^5 + 1620n^4 + 1044n^3 + 351n^2 + 54n + 2)
\end{align*}
given equation \eqref{2.117}.

The priority for choosing $(u_1, P_1)$ and $(u_2, P_2)$ will be placed on non-trivial solutions for $3$, for instance, solutions other than $(1,1,1)$. 
As a test case, we find $n$ for which integer solutions, as stated, were yielded:\\

\subsubsection{Determining $(u_1, P_1)$ and $(u_2, P_2)$}

For $(x_1,y_1,z_1) = (4,4,-5)$

\begin{align*}
    x+y+z &= 6n+3\\
    6n+3  &= 3 \\
    n &= 0
\end{align*}

Recall that $Q = -u_1 + 3(2n+1)^2$. $Q$ can be determined with the equation:

\begin{align*}
    Q &= (x+z)(y+z)\\
      &= (4-5)\cdot(4-5)\\
      &= 1
\end{align*}
\begin{align*}
    u_1 &= 3(2n+1)^2 - Q\\
        &= 2
\end{align*} 

\begin{align*}
    (u_1, P_1) = \left(2, \sqrt{2^3 + 2\cdot (-6n - 3) - (432n^6 + 1296n^5 + 1620n^4 + 1044n^3 + 351n^2 + 54n + 2)}\right)
\end{align*}


For $(x_2,y_2,z_2) = (569936821221962380720, -569936821113563493509, -472715493453327032)$

\begin{align*}
    x+y+z &= 6n+3\\
    6n+3  &= 569936821221962380720 -569936821113563493509 -472715493453327032  \\
    6n+3  &= -472715385054439821\\
       n  &= -78785897509073304
\end{align*}

Recall that $Q = -u_1 + 3(2n+1)^2$. $Q$ can be determined with the equation:

\begin{align*}
    Q &= (x+z)(y+z)\\
      &= (569936821221962380720-472715493453327032)\cdot(-569936821113563493509-472715493453327032)\\
      &= -324827756662928082157514599078022430205208
\end{align*}
\begin{align*}
    u_2 &= 3(2n+1)^2 - Q\\
        &= 3(2(-78785897509073304)+1)^2 - (-324827756662928082157514599078022430205208)\\
        &= 324827831149539837879950228963310467042555
\end{align*} 

\begin{align*}
    u_2 &= 324827831149539837879950228963310467042555 \\
    P_2 &= \sqrt{u_2^3 + u_2 \cdot (-6n - 3) - (432n^6 + 1296n^5 + 1620n^4 + 1044n^3 + 351n^2 + 54n + 2)}
\end{align*}


\subsubsection{Point addition for $k = 3$}

\subsubsubsection{Determining the slope, $\lambda$}

\begin{align*}
    \lambda &= \dfrac{P_2 - P_1}{u_2 - u_1}\\
            &= \dfrac{\sqrt{u_2^3 + u_2 \cdot (-6n - 3) + B} - \sqrt{2^3 + 2\cdot (-6n - 3) + B}}{324827831149539837879950228963310467042555-2}\\
            &= \dfrac{\sqrt{u_2^3 + u_2 \cdot (-6n - 3) + B} - \sqrt{2^3 + 2\cdot (-6n - 3) + B}}{324827831149539837879950228963310467042553}
\end{align*}

\subsubsubsection{Calculating $(u_3, P_3)$}

\begin{align*}
    u_3 &= \biggl(\dfrac{\sqrt{u_2^3 + u_2 \cdot (-6n - 3) + B} - \sqrt{2^3 + 2\cdot (-6n - 3) + B}}{324827831149539837879950228963310467042553}\biggl)^2 - u_1 - u_2 \\
       &= \biggl(\dfrac{\sqrt{u_2^3 + u_2 \cdot (-6n - 3) + B} - \sqrt{2^3 + 2\cdot (-6n - 3) + B}}{324827831149539837879950228963310467042553}\biggl)^2 - 2 - 324827831149539837879950228963310467042555  \\
       &= \biggl(\dfrac{\sqrt{u_2^3 + u_2 \cdot (-6n - 3) + B} - \sqrt{2^3 + 2\cdot (-6n - 3) + B}}{324827831149539837879950228963310467042553}\biggl)^2 - 324827831149539837879950228963310467042557  \\
\end{align*}

\begin{align*}
    P_3 = \left(\dfrac{\sqrt{u_2^3 + u_2 \cdot (-6n - 3) + B} - \sqrt{2^3 + 2\cdot (-6n - 3) + B}}{324827831149539837879950228963310467042553}\right)\cdot (2 - u_3) - P_1
\end{align*}


