# Define symbolic variables
var('n')

# Constants
u1 = 45497
u2 = 773908534847

# Define B
B = -(432*n^6 + 1296*n^5 + 1620*n^4 + 468*n^3 - 513*n^2 - 378*n - 142)

# Define u3
u3 = ((sqrt(u2^3 + u2*(-102*n - 51) + B) - sqrt(u1^3 + u1*(-102*n - 51) + B)) / (u2 - u1))^2 - u1 - u2

# Define Q
Q = -u3 + 3*(2*n + 1)^2

# Define P1
P1 = sqrt(u1^3 + u1*(-102*n - 51) - (432*n^6 + 1296*n^5 + 1620*n^4 + 468*n^3 - 513*n^2 - 378*n - 142))

# Define P3
P3 = ((sqrt(u2^3 + u2*(-102*n - 51) + B) - sqrt(u1^3 + u1*(-102*n - 51) + B)) / (u2 - u1))*(u1 - u3) - P1

# Define x, y, z
x = ((36*n^3 + 54*n^2 + 27*n - 4) + P3) / Q
y = ((36*n^3 + 54*n^2 + 27*n - 4) - P3) / Q
z = (6*n + 3) - 2*(36*n^3 + 54*n^2 + 27*n - 4) / Q

# Verification: compute x^3 + y^3 + z^3 for n = 1..7
print("Verification of x^3 + y^3 + z^3 = 51 for n = 1 to 7:\n")
for k in range(1, 8):
    val = (x^3 + y^3 + z^3).subs(n=k).simplify_full()
    print(f"n = {k} → {val}")
